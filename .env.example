# OpenAI API 키 (문서 자동 수정/요약에 사용)
OPENAI_API_KEY=your_openai_api_key_here

# 사용할 모델 이름 (기본값: gpt-5-search-api)
OPENAI_MODEL=gpt-5-search-api

# 서버 포트
PORT=3000

# 스케줄러 실행 주기 (cron 표현식, 기본값: 20분마다)
# 예: "*/20 * * * *" = 20분마다
SCHEDULE_CRON=*/20 * * * *

# SQLite DB 파일 경로 (클라우드 배포 시 영속 볼륨 경로로 지정)
DB_PATH=./data/omnicontext.db
